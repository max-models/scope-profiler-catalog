---
// One scope-profiler chart: fetches the plot-data JSON that `scope-profiler site` wrote under
// public/catalogue/ and draws it with @scope-profiler/plotly, in the colours of the site's
// light or dark theme. Plotly is loaded only once a chart scrolls into view.
interface Props {
	/** Site-root path of the plot-data file, for example `/catalogue/case/01-speedup.plot.json`. */
	src: string;
	title?: string;
	/** Builder options written next to the data, such as `{ comparison: "percent" }`. */
	options?: Record<string, unknown>;
	height?: number;
}
const { src, title = '', options = {}, height = 460 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<figure
	class="scope-chart"
	data-src={`${base}${src}`}
	data-options={JSON.stringify(options)}
	aria-label={title}
>
	{title && <figcaption>{title}</figcaption>}
	<div class="scope-chart-plot" style={`min-height: ${height}px`}></div>
</figure>

<style>
	.scope-chart {
		margin: 1.5rem 0;
	}
	.scope-chart figcaption {
		font-weight: 600;
		margin-bottom: 0.5rem;
	}
	.scope-chart-error {
		color: var(--sl-color-red);
	}
</style>

<script>
	import { buildComparisonFigure, buildFigure } from '@scope-profiler/plotly';

	type Chart = { figure: Element; plot: HTMLElement; payload?: unknown };
	const charts: Chart[] = [];
	let plotly: any;

	const theme = () => (document.documentElement.dataset.theme === 'light' ? 'light' : 'dark');

	async function draw(chart: Chart) {
		const { figure, plot } = chart;
		try {
			if (!chart.payload) {
				const response = await fetch((figure as HTMLElement).dataset.src!);
				if (!response.ok) throw new Error(`${response.status} ${response.statusText}`);
				chart.payload = await response.json();
			}
			plotly ??= (await import('plotly.js-dist-min')).default;
			const options = JSON.parse((figure as HTMLElement).dataset.options || '{}');
			const build = options.comparison ? buildComparisonFigure : buildFigure;
			const { layout: extra, ...rest } = options;
			const built = build(chart.payload as never, { ...rest, theme: theme(), layout: extra });
			const layout = { ...built.layout, paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)' };
			await plotly.react(plot, built.data, layout, { responsive: true, displaylogo: false });
		} catch (error) {
			plot.classList.add('scope-chart-error');
			plot.textContent = `Could not draw this chart: ${(error as Error).message}`;
		}
	}

	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				observer.unobserve(entry.target);
				const chart = charts.find((item) => item.figure === entry.target);
				if (chart) void draw(chart);
			}
		},
		{ rootMargin: '300px' },
	);

	for (const figure of document.querySelectorAll('.scope-chart')) {
		const plot = figure.querySelector<HTMLElement>('.scope-chart-plot');
		if (!plot) continue;
		charts.push({ figure, plot });
		observer.observe(figure);
	}

	// Redraw the charts that are on the page when the reader switches between light and dark.
	new MutationObserver(() => {
		for (const chart of charts) if (chart.payload) void draw(chart);
	}).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>
